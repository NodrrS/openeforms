{
  "name": "@openeforms/validate",
  "version": "0.1.0",
  "description": "ISO Schematron validation for eForms notices, in JavaScript. No JVM, no XSLT, no proprietary dependencies.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "files": ["dist", "README.md"],
  "engines": { "node": ">=20" },
  "scripts": { "build": "tsc -p tsconfig.json", "test": "node --test test/*.test.ts" },
  "keywords": ["schematron", "svrl", "eforms", "validation", "xpath", "procurement"],
  "dependencies": { "fontoxpath": "^3.34.0", "slimdom": "^4.3.5" }
}
